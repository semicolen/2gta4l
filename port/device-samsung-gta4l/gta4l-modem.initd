#!/sbin/openrc-run
supervisor=supervise-daemon
description="Keep the downstream Qualcomm LTE modem subsystem active"
command="/usr/bin/gta4l-subsystem"
command_args="/dev/subsys_modem"
respawn_delay=15

depend() {
	need qrtr-ns gta4l-rmtfs gta4l-pd-mapper gta4l-tqftpserv
	after udev-settle
	before modemmanager
}
