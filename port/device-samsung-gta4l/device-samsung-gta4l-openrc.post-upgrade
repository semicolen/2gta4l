#!/bin/sh -e
rc-update -q add qrtr-ns default
rc-update -q add modemmanager default
rc-update -q add bluetooth default
rc-update -q add gta4l-bluetooth default
rc-update -q del tqftpserv default 2>/dev/null || true
rc-update -q add gta4l-tqftpserv default
rc-update -q add gta4l-pd-mapper default
rc-update -q add gta4l-rmtfs default
rc-update -q add gta4l-modem default
rc-update -q add gta4l-ipa default
rc-update -q add gta4l-adsp default
rc-update -q add gta4l-dbus-services default
rc-update -q add gta4l-wlan default
rc-update -q add gta4l-sensors default
rc-update -q add iio-sensor-proxy default
rc-update -q add gta4l-camera default
rc-update -q del gta4l-gps-prepare default 2>/dev/null || true
