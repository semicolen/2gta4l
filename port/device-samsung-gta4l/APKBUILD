# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-gta4l
pkgdesc="Samsung Galaxy Tab A7 10.4 2020 (LTE)"
pkgver=1
pkgrel=22
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-samsung-gta4l
	mkbootimg
	postmarketos-base
	kmod
	xf86-video-fbdev
	bubblewrap-gta4l
	xorg-modesetting-gta4l
	mesa-vulkan-kgsl-gta4l
	alsa-ucm-gta4l
	networkmanager-bluetooth
	rotation-gta4l
	gps-gta4l
	camera-gta4l
	xfce4-screensaver=4.20.2-r1
"
makedepends="devicepkg-dev"
install="$pkgname-openrc.post-install $pkgname-openrc.post-upgrade"

subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-openrc
"

source="
	deviceinfo
	modules-initfs
	98-touchscreen-cal.rules
	90-gta4l-fbdev.conf
	gta4l-rmtfs.initd
	gta4l-modem.initd
	gta4l-subsystem.c
	gta4l-ipa.initd
	78-mm-gta4l.rules
	79-gta4l-kgsl.rules
	79-gta4l-ion.rules
	gta4l-adsp.initd
	gta4l-dbus-services.initd
	polkit.confd
"

build() {
	devicepkg_build $startdir $pkgname
	${CC:-cc} $CFLAGS "$srcdir/gta4l-subsystem.c" $LDFLAGS -o "$srcdir/gta4l-subsystem"
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir/90-gta4l-fbdev.conf" \
		"$pkgdir/etc/X11/xorg.conf.d/90-gta4l-fbdev.conf"
	install -Dm644 "$srcdir/79-gta4l-kgsl.rules" "$pkgdir/etc/udev/rules.d/79-gta4l-kgsl.rules"
	install -Dm644 "$srcdir/79-gta4l-ion.rules" "$pkgdir/etc/udev/rules.d/79-gta4l-ion.rules"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="openrc qrtr-ns-gta4l pd-mapper-gta4l rmtfs rmtfs-udev modemmanager-openrc polkit-openrc bluez-openrc bluetooth-gta4l tqftpserv-gta4l wlfw-gta4l sensors-gta4l-openrc iio-sensor-proxy-openrc camera-gta4l-openrc"
	mkdir -p "$subpkgdir"
	install -Dm755 "$srcdir/gta4l-rmtfs.initd" "$subpkgdir/etc/init.d/gta4l-rmtfs"
	install -Dm755 "$srcdir/gta4l-modem.initd" "$subpkgdir/etc/init.d/gta4l-modem"
	install -Dm755 "$srcdir/gta4l-ipa.initd" "$subpkgdir/etc/init.d/gta4l-ipa"
	install -Dm755 "$srcdir/gta4l-adsp.initd" "$subpkgdir/etc/init.d/gta4l-adsp"
	install -Dm755 "$srcdir/gta4l-dbus-services.initd" "$subpkgdir/etc/init.d/gta4l-dbus-services"
	install -Dm644 "$srcdir/78-mm-gta4l.rules" "$subpkgdir/etc/udev/rules.d/78-mm-gta4l.rules"
	install -Dm755 "$srcdir/gta4l-subsystem" "$subpkgdir/usr/bin/gta4l-subsystem"
	install -Dm644 "$srcdir/polkit.confd" "$subpkgdir/etc/conf.d/polkit"
}

nonfree_firmware() {
	pkgdesc="SM-T505 vendor firmware for touchscreen, wireless, GPU, DSPs and LTE"
	depends="firmware-samsung-gta4l"
	mkdir "$subpkgdir"

	# Touchscreen rotation fix
	install -Dm644 "$srcdir"/98-touchscreen-cal.rules \
		"$subpkgdir"/etc/udev/rules.d/98-touchscreen-cal.rules
}

