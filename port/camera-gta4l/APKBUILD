pkgname=camera-gta4l
pkgver=1.0
pkgrel=2
pkgdesc="SM-T505 stock HAL camera preview and photo capture"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!strip !check !archcheck !tracedeps"
depends="python3 py3-gobject3 gtk+3.0 firmware-samsung-gta4l"
makedepends="clang lld"
subpackages="$pkgname-openrc"
source="gta4l-camera-runtime-T505XXS8CXG1.tar.gz
    camera-hal-enumerate.c camera-buffer.h
    gta4l-camera-run gta4l-camera-service.py gta4l-camera.py
    gta4l-camera.desktop gta4l-camera.initd"

build() {
    clang --target=aarch64-linux-android31 -ffreestanding -fPIE -pie -O2 \
        -Wall -Wextra -Werror -fno-stack-protector -nostdlib -fuse-ld=lld \
        -Wl,-e,_start -Wl,--export-dynamic \
        -Wl,--dynamic-linker=/apex/com.android.runtime/bin/linker64 \
        -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now -Wl,--build-id=sha1 \
        "$srcdir/camera-hal-enumerate.c" \
        -L"$srcdir/apex/com.android.runtime/lib64/bionic" \
        -Wl,-rpath,/apex/com.android.runtime/lib64/bionic \
        -lc -ldl -o "$srcdir/camera-hal-enumerate"
}

package() {
    local runtime="$pkgdir/usr/lib/gta4l-camera/runtime"
    mkdir -p "$runtime"
    cp -a "$srcdir/apex" "$srcdir/vendor" "$srcdir/system" "$runtime/"
    mkdir -p "$runtime/dev" "$runtime/proc" "$runtime/sys" "$runtime/lib/firmware" \
        "$runtime/usr/lib/firmware" "$runtime/data/vendor/camera" "$runtime/run/gta4l-camera"
    install -Dm755 "$srcdir/camera-hal-enumerate" "$runtime/system/bin/camera-hal-enumerate"
    install -Dm755 "$srcdir/gta4l-camera.py" "$pkgdir/usr/bin/gta4l-camera"
    install -Dm755 "$srcdir/gta4l-camera-service.py" "$pkgdir/usr/libexec/gta4l-camera-service.py"
    install -Dm755 "$srcdir/gta4l-camera-run" "$pkgdir/usr/libexec/gta4l-camera-run"
    install -Dm755 "$srcdir/gta4l-camera.initd" "$pkgdir/etc/init.d/gta4l-camera"
    install -Dm644 "$srcdir/gta4l-camera.desktop" "$pkgdir/usr/share/applications/gta4l-camera.desktop"
}

