pkgname=qrtr-ns-gta4l
pkgver=1.2
pkgrel=0
pkgdesc="QRTR userspace name server for the SM-T505 downstream kernel"
url="https://github.com/linux-msm/qrtr"
arch="aarch64"
license="BSD-3-Clause"
options="!check"
depends="qrtr-libs"
makedepends="meson linux-headers"
source="qrtr-v$pkgver.tar.gz::https://github.com/linux-msm/qrtr/archive/v$pkgver/qrtr-v$pkgver.tar.gz
	qrtr-ns.initd
"
builddir="$srcdir/qrtr-$pkgver"

build() {
	abuild-meson -Dqrtr-ns=enabled -Dsystemd-service=disabled . output
	meson compile -C output
}

package() {
	# qrtr supplies the library and diagnostic tools; install only the missing daemon.
	install -Dm755 output/src/qrtr-ns "$pkgdir/usr/bin/qrtr-ns"
	install -Dm755 "$srcdir/qrtr-ns.initd" "$pkgdir/etc/init.d/qrtr-ns"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

sha512sums="
