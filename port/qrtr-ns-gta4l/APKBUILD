979e49a6822cda802bb65faa42cc0e37d1ffeea1c454a28f94102f6f7f4b1dd2b20146cdf72c251889bc3e8ae66b000cfcda799c61ae0afeef51f96d49bb7f2a  qrtr-ns.initd
"
