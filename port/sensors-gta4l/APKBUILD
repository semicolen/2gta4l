pkgname=sensors-gta4l
pkgver=1.0
pkgrel=0
pkgdesc="Downstream sensor registry startup for SM-T505"
url="https://github.com/semicolen/2gta4l"
arch="aarch64"
license="MIT"
options="!check !archcheck"
depends="hexagonrpc-gta4l firmware-sensors-gta4l python3 e2fsprogs-extra"
subpackages="$pkgname-openrc"
source="gta4l-sensors-prepare.py gta4l-sensors.initd iio-sensor-proxy.confd"
package() {
    install -Dm755 "$srcdir/gta4l-sensors-prepare.py" "$pkgdir/usr/bin/gta4l-sensors-prepare"
}
openrc() {
    install_if="$pkgname=$pkgver-r$pkgrel openrc"
    depends="openrc iio-sensor-proxy-openrc"
    install -Dm755 "$srcdir/gta4l-sensors.initd" "$subpkgdir/etc/init.d/gta4l-sensors"
    install -Dm644 "$srcdir/iio-sensor-proxy.confd" "$subpkgdir/etc/conf.d/iio-sensor-proxy"
}
