f45fa6c6207c06089df4898776c6a371b5cb822f52d4f20a82423b6f5314b2b2e071f5d2806486b57d1de523d1c376c0c2fc564f60b6f8652abc55786894220e  zink-explicit-kgsl-device.patch
ef6e1445d4202e4e0cf0830430bbd5fb6cdf86b017c2780a7538d1f99753b4d596fa36aa27c9c61906008f06bb48bd67bd722c800a7c809015c95e12c23562bd  gta4l-zink-run
"
