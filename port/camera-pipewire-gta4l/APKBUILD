pkgname=camera-pipewire-gta4l
pkgver=1.0
pkgrel=0
pkgdesc="Standard PipeWire camera sources for the SM-T505 stock-HAL broker"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
options="!check"
depends="camera-gta4l=1.0-r5 pipewire wireplumber python3"
makedepends="pipewire-dev wayland-dev"
source="gta4l-camera-pipewire.c gta4l-camera-pipewire-session.py
    gta4l-camera-pipewire.desktop 60-gta4l-camera.conf"

build() {
    cc -O2 -Wall -Wextra -Werror -pthread "$srcdir/gta4l-camera-pipewire.c" \
        -o gta4l-camera-pipewire $(pkg-config --cflags --libs libpipewire-0.3 wayland-client)
}

package() {
    install -Dm755 gta4l-camera-pipewire "$pkgdir/usr/libexec/gta4l-camera-pipewire"
    install -Dm755 "$srcdir/gta4l-camera-pipewire-session.py" "$pkgdir/usr/libexec/gta4l-camera-pipewire-session"
    install -Dm644 "$srcdir/gta4l-camera-pipewire.desktop" "$pkgdir/etc/xdg/autostart/gta4l-camera-pipewire.desktop"
    install -Dm644 "$srcdir/60-gta4l-camera.conf" "$pkgdir/etc/wireplumber/wireplumber.conf.d/60-gta4l-camera.conf"
}

