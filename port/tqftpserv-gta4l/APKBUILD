5d6ff040d6c7632aeff46fbb01d598cdf9d0ed0b35560b8a9cff021dff171cc64314cbead684714089f48a67a49f82e4ad702fd30888a1ee7baf678b2070428a  downstream-firmware.patch
111f7c70e7bfbf3d684549cca50c5cf656cb9e2e1abe5514866c108aababd4ae2b3b792cf41ddb2053b120dd904d2b068a9849affec48c32544e533b59aae135  gta4l-tqftpserv.initd
