pkgname=tqftpserv-gta4l
pkgver=1.2
pkgrel=0
pkgdesc="Qualcomm firmware server with downstream subsystem path support"
url="https://github.com/linux-msm/tqftpserv"
arch="aarch64"
license="BSD-3-Clause"
options="!check"
makedepends="meson qrtr-dev zstd-dev"
source="tqftpserv-v$pkgver.tar.gz::https://github.com/linux-msm/tqftpserv/archive/refs/tags/v$pkgver.tar.gz
    downstream-firmware.patch
    gta4l-tqftpserv.initd
    translation-test.c
"
builddir="$srcdir/tqftpserv-$pkgver"

build() {
    abuild-meson -Dsystemd-unit-prefix=/usr/lib/systemd/system/ . output
    meson compile -C output
    ${CC:-cc} $CFLAGS -DHAVE_ZSTD -I. "$srcdir/translation-test.c" translate.c zstd-decompress.c \
        $LDFLAGS -lzstd -o output/translation-test
    ./output/translation-test
}

package() {
    install -Dm755 output/tqftpserv "$pkgdir/usr/bin/tqftpserv-gta4l"
    install -Dm755 "$srcdir/gta4l-tqftpserv.initd" "$pkgdir/etc/init.d/gta4l-tqftpserv"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

