pkgname=pd-mapper-gta4l
pkgver=1.1
pkgrel=0
pkgdesc="Qualcomm PD mapper with downstream firmware directory support"
url="https://github.com/linux-msm/pd-mapper"
arch="aarch64"
license="BSD-3-Clause"
options="!check"
makedepends="qrtr-dev xz-dev"
source="pd-mapper-v$pkgver.tar.gz::https://github.com/linux-msm/pd-mapper/archive/v$pkgver/pd-mapper-v$pkgver.tar.gz
	downstream-firmware.patch
	gta4l-pd-mapper.initd
"
builddir="$srcdir/pd-mapper-$pkgver"

build() {
	make prefix=/usr
}

package() {
	install -Dm755 pd-mapper "$pkgdir/usr/bin/pd-mapper-gta4l"
	install -Dm755 "$srcdir/gta4l-pd-mapper.initd" "$pkgdir/etc/init.d/gta4l-pd-mapper"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

