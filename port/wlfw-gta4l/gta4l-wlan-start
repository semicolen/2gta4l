#!/bin/sh
set -eu
# The file comes from this tablet's matching T505XXS8CXG1 stock vendor image.
# Never substitute another board's BDF or fabricate calibration values.
bdf=/lib/firmware/postmarketos/wlan/qca_cld/bdwlan.bin
printf '%s\n' "a18a7fce954ca5b4e7758a4853844d1bdc48e9dbec793c54356e4667c44834e8  $bdf" | sha256sum -c -
if [ -d /sys/class/net/wlan0 ]; then
    echo 'wlan0 already exists'
    exit 0
fi
test -c /dev/wlan
endpoint=
for attempt in $(seq 1 30); do
    # WLFW service is 0x45, printed by qrtr-lookup as decimal 69.
    endpoint=$(qrtr-lookup | awk '$1 == 69 && $2 == 1 && $3 == 0 { print $4, $5; exit }')
    if [ -n "$endpoint" ]; then break; fi
    sleep 1
done
if [ -z "$endpoint" ]; then echo 'WLFW endpoint not available' >&2; exit 1; fi
set -- $endpoint
test "$#" -eq 2
case "$1:$2" in *[!0-9:]*|:*) echo 'Invalid WLFW endpoint' >&2; exit 1;; esac
timeout -k 2 45 /usr/bin/wlfw-initialize-gta4l "$1" "$2" "$bdf"
timeout -k 5 25 /bin/sh -c 'printf "ON\n" > /dev/wlan'
for attempt in $(seq 1 10); do
    if [ -d /sys/class/net/wlan0 ]; then
        echo 'GTA4L_WLAN_INTERFACE_READY'
        exit 0
    fi
    sleep 1
done
echo 'WLAN firmware ready, but wlan0 did not appear' >&2
exit 1
