pkgname=wlfw-gta4l
pkgver=1.0
pkgrel=0
pkgdesc="Stock WLAN board-data initialization for the SM-T505 downstream kernel"
url="https://github.com/semicolen/2gta4l"
arch="aarch64"
license="MIT"
options="!check"
depends="qrtr firmware-samsung-gta4l"
source="wlfw-initialize.c gta4l-wlan-start gta4l-wlan.initd"
builddir="$srcdir"

build() {
    ${CC:-cc} $CFLAGS -O2 -Wall -Wextra -Werror wlfw-initialize.c $LDFLAGS -o wlfw-initialize
}

package() {
    install -Dm755 wlfw-initialize "$pkgdir/usr/bin/wlfw-initialize-gta4l"
    install -Dm755 gta4l-wlan-start "$pkgdir/usr/bin/gta4l-wlan-start"
    install -Dm755 gta4l-wlan.initd "$pkgdir/etc/init.d/gta4l-wlan"
}

