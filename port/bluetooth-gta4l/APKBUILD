pkgname=bluetooth-gta4l
pkgver=1.0
pkgrel=0
pkgdesc="Stock WCN3988 Bluetooth bootstrap for the SM-T505 downstream UART"
url="https://github.com/semicolen/2gta4l"
arch="aarch64"
license="MIT"
options="!check !archcheck"
depends="python3 bluez e2fsprogs-extra firmware-samsung-gta4l"
source="gta4l-bt-initialize.py gta4l-bluetooth.initd"

package() {
    install -Dm755 "$srcdir/gta4l-bt-initialize.py" "$pkgdir/usr/bin/gta4l-bt-initialize"
    install -Dm755 "$srcdir/gta4l-bluetooth.initd" "$pkgdir/etc/init.d/gta4l-bluetooth"
}

