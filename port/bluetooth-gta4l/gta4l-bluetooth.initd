#!/sbin/openrc-run
supervisor=supervise-daemon
description="Initialize and hold the SM-T505 downstream Bluetooth UART"
command="/usr/bin/gta4l-bt-initialize"
respawn_delay=15
respawn_max=3
respawn_period=60
output_log="/var/log/gta4l/bluetooth.log"
error_log="/var/log/gta4l/bluetooth.log"

depend() {
    after udev-settle
    before bluetooth
}

start_pre() {
    checkpath -d -m 0755 -o root:root /var/log/gta4l
    checkpath -f -m 0600 -o root:root /var/log/gta4l/bluetooth.log
}
