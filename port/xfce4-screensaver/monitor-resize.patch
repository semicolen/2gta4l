+    GdkMonitor *monitor = gdk_display_get_monitor (display, monitor_index);
+    if (monitor == NULL)
+        monitor = gdk_display_get_monitor (display, 0);
+    if (monitor != NULL)
+        g_signal_connect_object (monitor, "notify::geometry",
+                                 G_CALLBACK (lock_monitor_geometry_notify), plug, 0);
+
