pkgname=hexagonrpc-gta4l
pkgver=0.5.0
pkgrel=0
pkgdesc="Qualcomm sensor file server for the SM-T505 downstream FastRPC ABI"
url="https://github.com/linux-msm/hexagonrpc"
arch="aarch64"
license="GPL-3.0-or-later LGPL-3.0-or-later MIT"
makedepends="meson linux-headers"
subpackages="$pkgname-dbg $pkgname-doc"
source="hexagonrpc-da7a3742ab8d5273a281b70ee11f16fb2cb6a690.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/da7a3742ab8d5273a281b70ee11f16fb2cb6a690.tar.gz
    gta4l-fastrpc.h
    downstream-fastrpc.patch
    gta4l-reference-uapi.h
    kernel-abi-test.c
"
builddir="$srcdir/hexagonrpc-da7a3742ab8d5273a281b70ee11f16fb2cb6a690"

prepare() {
    default_prepare
    cp "$srcdir/gta4l-fastrpc.h" include/
}

build() {
    abuild-meson -Dhexagonrpcd_verbose=true . output
    meson compile -C output
    ${CC:-cc} $CFLAGS -Iinclude -I"$srcdir" "$srcdir/kernel-abi-test.c" $LDFLAGS -o output/kernel-abi-test
}

check() {
    meson test --print-errorlogs -C output
    ./output/kernel-abi-test
}

package() {
    install -Dm755 output/hexagonrpcd/hexagonrpcd "$pkgdir/usr/bin/hexagonrpcd-gta4l"
    install -Dm755 output/libhexagonrpc/libhexagonrpc.so.0.5 "$pkgdir/usr/lib/libhexagonrpc.so.0.5"
    install -Dm644 hexagonrpcd/hexagonrpcd.1 "$pkgdir/usr/share/man/man1/hexagonrpcd-gta4l.1"
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

