pkgname=gps-assistance-gta4l
pkgver=1.0
pkgrel=0
pkgdesc="On-demand orbit assistance for the SM-T505 GNSS receiver"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
options="!check"
depends="gps-gta4l=1.0-r5 python3 py3-dbus py3-gobject3"
subpackages="$pkgname-openrc"
source="gta4l-gps-assistance.py gta4l-gps-assistance.initd"

package() {
    install -Dm755 "$srcdir/gta4l-gps-assistance.py" "$pkgdir/usr/libexec/gta4l-gps-assistance.py"
    install -Dm755 "$srcdir/gta4l-gps-assistance.initd" "$pkgdir/etc/init.d/gta4l-gps-assistance"
}

