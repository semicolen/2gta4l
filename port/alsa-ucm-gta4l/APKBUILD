pkgname=alsa-ucm-gta4l
pkgver=1.0
pkgrel=4
pkgdesc="ALSA speaker and microphone routing for Samsung Galaxy Tab A7 LTE (SM-T505)"
url="https://github.com/semicolen/2gta4l"
arch="aarch64"
license="MIT"
depends="alsa-ucm-conf"
options="!check !archcheck"
subpackages="$pkgname-pulseaudio:pulse"
source="gta4l.conf HiFi.conf 90-gta4l-audio.rules 90-gta4l-audio.pa"

package() {
	install -Dm644 "$srcdir/gta4l.conf" "$pkgdir/usr/share/alsa/ucm2/Qualcomm/gta4l/gta4l.conf"
	install -Dm644 "$srcdir/HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/Qualcomm/gta4l/HiFi.conf"
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/bengal-qrd-snd-"
	ln -s ../../Qualcomm/gta4l/gta4l.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/bengal-qrd-snd-/bengal-qrd-snd-card.conf"
}

pulse() {
	pkgdesc="PulseAudio timing for the SM-T505 downstream DSP"
	install_if="$pkgname=$pkgver-r$pkgrel pulseaudio"
	depends="pulseaudio-alsa"
	install -Dm644 "$srcdir/90-gta4l-audio.rules" "$subpkgdir/usr/lib/udev/rules.d/90-gta4l-audio.rules"
	install -Dm644 "$srcdir/90-gta4l-audio.pa" "$subpkgdir/etc/pulse/default.pa.d/90-gta4l-audio.pa"
}

