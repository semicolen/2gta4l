# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/gta4l_eur_open_defconfig

pkgname=linux-samsung-gta4l
pkgver=4.19.300
pkgrel=8
pkgdesc="Samsung Galaxy Tab A7 10.4 2020 (LTE) kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="samsung-gta4l"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	openssl-dev
	perl
	linux-headers
	clang
	llvm
	lld
	xz
	kmod
"

export CC="clang"	
export HOSTCC="clang"
export KERNEL_IMAGE_NAME="Image.gz"
export LLVM="1"
export LLVM_IAS="1"

# Source
_repository="android_kernel_samsung_sm6115"
_commit="381a5549ee66fa751f632ee0840f5631274209ee"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	avoid-assertion-failure.patch
	restore-hci-sockets.patch
	cache-drm-refresh.patch
	backlight-status.patch
	touch-resume-order.patch
	plane-resume-state.patch
	guard-qca-tty.patch
	restore-bt-module-build.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	make dtbs_install O="$_outdir" ARCH="$_carch" \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	# Samsung's v2 boot header carries a concatenated Qualcomm DTB payload.
	# Preserve every compiled board/SoC revision for bootloader ID selection.
	mkdir -p "$pkgdir/boot/dtbs/qcom"
	find "$_outdir/arch/arm64/boot/dts" -name '*.dtb' -type f \
		| LC_ALL=C sort | xargs cat > "$pkgdir/boot/dtbs/qcom/gta4l.dtb"
	test -s "$pkgdir/boot/dtbs/qcom/gta4l.dtb"

	# The vendor audio, WLAN and rmnet drivers are modules. The downstream
	# packaging helper installs only the kernel image; include every built module.
	make modules_install O="$_outdir" ARCH="$_carch" \
		INSTALL_MOD_PATH="$pkgdir" DEPMOD=/bin/true
	# Build/source symlinks would point into the disposable build chroot.
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source
	depmod -b "$pkgdir" "$(cat "$_outdir/include/config/kernel.release")"
	# Use the names produced by this source revision, rather than stock Android
	# aliases. Some Lineage modules use *_dlkm names.
	mkdir -p "$pkgdir/etc/modules-load.d"
	find "$pkgdir/lib/modules" -name '*.ko' -type f \
		| grep -E '/(techpack/audio/|drivers/staging/qcacld-3.0/)' \
		| LC_ALL=C sort | sed 's|.*/||;s/\.ko$//' \
		> "$pkgdir/etc/modules-load.d/gta4l.conf"
	grep -q '^wlan$' "$pkgdir/etc/modules-load.d/gta4l.conf"
	grep -q '^machine_dlkm$' "$pkgdir/etc/modules-load.d/gta4l.conf"
}

