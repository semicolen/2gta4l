 #define HX_KEY_F_LEFT					271
-#define HX_KEY_DF_UP					272
-#define HX_KEY_DF_DOWN				273
-#define HX_KEY_DF_LEFT				274
-#define HX_KEY_DF_RIGHT				275
+#define HX_KEY_DF_UP					KEY_F13
+#define HX_KEY_DF_DOWN				KEY_F14
