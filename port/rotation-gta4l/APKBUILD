pkgname=rotation-gta4l
pkgver=1.0
pkgrel=0
pkgdesc="Automatic Xfce display and touch rotation for Galaxy Tab A7 LTE"
url="https://github.com/semicolen/2gta4l"
arch="aarch64"
license="MIT"
options="!check !archcheck"
depends="python3 py3-dbus py3-gobject3 xrandr xinput xset iio-sensor-proxy sensors-gta4l"
source="gta4l-rotate.py gta4l-rotation.desktop gta4l-rotation-lock.desktop 81-gta4l-sensors.rules org.postmarketos.Gta4l.Rotation.service"
package() {
    install -Dm755 "$srcdir/gta4l-rotate.py" "$pkgdir/usr/bin/gta4l-rotate"
    install -Dm644 "$srcdir/gta4l-rotation.desktop" "$pkgdir/etc/xdg/autostart/gta4l-rotation.desktop"
    install -Dm644 "$srcdir/gta4l-rotation-lock.desktop" "$pkgdir/usr/share/applications/gta4l-rotation-lock.desktop"
    install -Dm644 "$srcdir/81-gta4l-sensors.rules" "$pkgdir/etc/udev/rules.d/81-gta4l-sensors.rules"
    install -Dm644 "$srcdir/org.postmarketos.Gta4l.Rotation.service" "$pkgdir/usr/share/dbus-1/services/org.postmarketos.Gta4l.Rotation.service"
}
